generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  ADMIN
}

enum PlanKind {
  FIXED
  CUSTOM
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  IN_PROGRESS
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  BANK
  JAZZCASH
  EASYPAISA
  CRYPTO_PLISIO
}

enum PaymentStatus {
  AWAITING
  RECEIPT_UPLOADED
  CONFIRMED
  REJECTED
}

enum ProjectStage {
  QUEUED
  DESIGN
  BUILD
  REVIEW
  LIVE
}

enum TicketStatus {
  OPEN
  ANSWERED
  CLOSED
}

enum FileKind {
  RECEIPT
  INVOICE
  DELIVERABLE
  ATTACHMENT
}

model User {
  id            String          @id @default(cuid())
  name          String?
  email         String          @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          Role            @default(CLIENT)
  disabled      Boolean         @default(false)
  createdAt     DateTime        @default(now())
  accounts      Account[]
  sessions      Session[]
  orders        Order[]
  tickets       Ticket[]
  files         File[]
  messages      TicketMessage[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Plan {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  tagline      String
  kind         PlanKind @default(FIXED)
  priceCents   Int?
  setupCents   Int?
  perPageCents Int?
  features     String[]
  sort         Int      @default(0)
  active       Boolean  @default(true)
  orders       Order[]
}

model Order {
  id         String      @id @default(cuid())
  userId     String
  planId     String
  pages      Int?
  totalCents Int
  currency   String      @default("USD")
  status     OrderStatus @default(PENDING_PAYMENT)
  notes      String?
  createdAt  DateTime    @default(now())
  user       User        @relation(fields: [userId], references: [id])
  plan       Plan        @relation(fields: [planId], references: [id])
  payment    Payment?
  project    Project?
  invoice    Invoice?
  tickets    Ticket[]
  files      File[]

  @@index([userId])
}

model Payment {
  id               String        @id @default(cuid())
  orderId          String        @unique
  method           PaymentMethod
  status           PaymentStatus @default(AWAITING)
  amountCents      Int
  accountName      String?
  reference        String?
  receiptFileId    String?
  rejectReason     String?
  plisioTxnId      String?       @unique
  plisioInvoiceUrl String?
  submittedAt      DateTime?
  confirmedAt      DateTime?
  createdAt        DateTime      @default(now())
  order            Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Project {
  id        String       @id @default(cuid())
  orderId   String       @unique
  title     String
  stage     ProjectStage @default(QUEUED)
  progress  Int          @default(0)
  liveUrl   String?
  updatedAt DateTime     @updatedAt
  order     Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Invoice {
  id       String   @id @default(cuid())
  orderId  String   @unique
  number   String   @unique
  fileId   String?
  issuedAt DateTime @default(now())
  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Ticket {
  id        String          @id @default(cuid())
  userId    String
  orderId   String?
  subject   String
  status    TicketStatus    @default(OPEN)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  user      User            @relation(fields: [userId], references: [id])
  order     Order?          @relation(fields: [orderId], references: [id])
  messages  TicketMessage[]

  @@index([userId])
}

model TicketMessage {
  id        String   @id @default(cuid())
  ticketId  String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id])
  files     File[]
}

model File {
  id           String         @id @default(cuid())
  ownerId      String
  orderId      String?
  messageId    String?
  kind         FileKind
  storageKey   String         @unique
  originalName String
  mime         String
  size         Int
  createdAt    DateTime       @default(now())
  owner        User           @relation(fields: [ownerId], references: [id])
  order        Order?         @relation(fields: [orderId], references: [id])
  message      TicketMessage? @relation(fields: [messageId], references: [id])
}

model SiteContent {
  key         String   @id
  value       Json
  updatedAt   DateTime @updatedAt
  updatedById String?
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime
}

// Written by the Go service, read by the analytics pages
model PageView {
  id        BigInt   @id @default(autoincrement())
  path      String
  visitor   String
  referrer  String?
  device    String?
  country   String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([path])
}